# =============================================================================
# PHANTASM (SIH26182) — ENVIRONMENT CONFIGURATION
# =============================================================================

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
SECRET_KEY=phantasm_super_secure_secret_key_change_in_production_32_chars_min
API_V1_STR=/api/v1
PROJECT_NAME="PHANTASM — Forensic Attribution Engine"

# PostgreSQL (Canonical Store, Case Spine, Audit Log)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=phantasm
POSTGRES_PASSWORD=phantasm_dev_secret
POSTGRES_DB=phantasm
DATABASE_URL=postgresql+psycopg://phantasm:phantasm_dev_secret@localhost:5432/phantasm
# Fallback SQLite URL when Docker/Postgres is offline
FALLBACK_SQLITE_URL=sqlite:///./phantasm_dev.db

# Neo4j (Chain-Sharded Multigraph Store)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=phantasm_dev_secret

# Redis (Hot Cache, Rate Limits, Celery Broker)
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 Object Store (Dossiers, Model Artifacts, Merkle Bundles)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=phantasm_minio
MINIO_SECRET_KEY=phantasm_minio_secret
MINIO_BUCKET_DOSSIERS=phantasm-dossiers
MINIO_BUCKET_MODELS=phantasm-models
MINIO_BUCKET_EVIDENCE=phantasm-evidence
MINIO_SECURE=false

# Provider RPC Endpoints (Ingestion Layer)
ETHERSCAN_API_KEY=your_key_here
ALCHEMY_API_KEY=
BLOCKCHAIR_API_KEY=
MEMPOOL_SPACE_API_URL=https://mempool.space/api
BITQUERY_API_KEY=

# Finality Thresholds (Min confirmations before path search inclusion)
FINALITY_CONFIRMATIONS_BITCOIN=6
FINALITY_CONFIRMATIONS_ETHEREUM=12
FINALITY_CONFIRMATIONS_TRON=19
FINALITY_CONFIRMATIONS_SOLANA=32

# Statutory & SAHYOG Configuration
SAHYOG_CONNECTOR_MODE=MOCK
SAHYOG_API_URL=https://mock.sahyog.internal/api/v2
SAHYOG_API_KEY=mock_sahyog_dev_token

# ML & Intelligence Core
ELLIPTIC_DATASET_PATH=./data/elliptic
HAWKES_MU=0.1
HAWKES_ALPHA=0.5
HAWKES_BETA=1.0
